{
  "name": "borrowly",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "start": "node server.js",
    "check": "svelte-kit sync && svelte-check",
    "check:watch": "svelte-kit sync && svelte-check --watch",
    "test": "node --test src/lib/admin-stats.test.js tests/roles.test.mjs",
    "setup:stats-db": "node --env-file-if-exists=.env scripts/setup-stats-db.mjs --apply",
    "refactor:db": "node --env-file-if-exists=.env scripts/refactor-db.mjs --apply"
  },
  "dependencies": {
    "@lucide/svelte": "^1.38.0",
    "pocketbase": "^0.27.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.16"
  }
}
