# PocketBase URL reachable by the browser and this Node server
# The browser uses the same-origin proxy. Set the private target only in deployment.
VITE_POCKETBASE_URL=/api/db
VITE_USE_PROXY=true
VITE_POCKETBASE_TARGET=
VITE_POCKETBASE_OIDC_PROVIDER=oidc

# Server-only OIDC completion settings; never use a VITE_ prefix for credentials
# Set true only behind a trusted reverse proxy that overwrites client-IP headers.
# TRUST_PROXY=false
POCKETBASE_URL=
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
OIDC_USERINFO_URL=
